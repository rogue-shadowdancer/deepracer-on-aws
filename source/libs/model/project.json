{
  "name": "model",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/model/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "generate": {
      "cache": true,
      "description": "Generates api model, client, and server",
      "executor": "nx:run-commands",
      "inputs": ["{projectRoot}/src/**/*", "{projectRoot}/smithy-build-gradle.json"],
      "outputs": ["{projectRoot}/build/**/*"],
      "options": {
        "command": "node -e \"const { spawnSync } = require('node:child_process'); const cmd = process.platform === 'win32' ? 'gradlew.bat' : './gradlew'; const result = spawnSync(cmd, ['clean', 'build'], { stdio: 'inherit', shell: process.platform === 'win32' }); process.exit(result.status ?? 1);\"",
        "cwd": "libs/model"
      }
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node -e \"require('node:fs').rmSync('build', { recursive: true, force: true });\"",
        "cwd": "libs/model"
      }
    },
    "copy:client": {
      "cache": true,
      "executor": "nx:run-commands",
      "inputs": ["{projectRoot}/src/**/*", "{projectRoot}/smithy-build-gradle.json"],
      "outputs": ["{workspaceRoot}/libs/typescript-client/src/**/*"],
      "options": {
        "command": "node libs/model/scripts/copy-generated-typescript.mjs libs/model/build/smithyprojections/model/source/typescript-codegen/src libs/typescript-client/src client"
      },
      "dependsOn": ["generate"]
    },
    "copy:server-client": {
      "cache": true,
      "executor": "nx:run-commands",
      "inputs": ["{projectRoot}/src/**/*", "{projectRoot}/smithy-build-gradle.json"],
      "outputs": ["{workspaceRoot}/libs/typescript-server-client/src/**/*"],
      "options": {
        "command": "node libs/model/scripts/copy-generated-typescript.mjs libs/model/build/smithyprojections/model/source/typescript-ssdk-codegen/src libs/typescript-server-client/src server"
      },
      "dependsOn": ["generate"]
    },
    "build": {
      "cache": true,
      "description": "Build model and both typescript clients",
      "executor": "nx:run-commands",
      "inputs": ["{projectRoot}/src/**/*", "{projectRoot}/smithy-build-gradle.json"],
      "options": {
        "commands": []
      },
      "dependsOn": ["copy:client", "copy:server-client"]
    }
  }
}
